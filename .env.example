# --- Database (Neon Postgres) ---
# Pooled connection (host contains "-pooler") — used at runtime by the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection (no "-pooler") — used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# AUTH_URL is optional (trustHost is enabled, so the host is inferred from the
# request). Set it only to force a canonical URL, e.g. in some proxy setups.
# AUTH_URL="https://your-domain.com"

# --- Seed (used only by `npm run prisma:seed` to create the first admin) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# --- New-lead alerts (all optional; each channel turns on only when its vars are set) ---
# Email via Resend (https://resend.com). Create an API key, then set where alerts go.
RESEND_API_KEY=""
LEAD_ALERT_EMAIL=""            # inbox that should receive a booking alert, e.g. ai.flowint@gmail.com
# LEAD_ALERT_FROM="Flowint AI <onboarding@resend.dev>"  # set to a verified sender once a domain is connected

# WhatsApp via the Meta Cloud API. Needs a WhatsApp Business number and a
# pre-approved template whose body has 4 variables: {{1}} business, {{2}} name,
# {{3}} phone, {{4}} email.
WHATSAPP_TOKEN=""             # permanent access token
WHATSAPP_PHONE_ID=""         # phone number ID from the Meta dashboard
WHATSAPP_ALERT_TO=""         # number to notify, international format e.g. 919322001355
WHATSAPP_TEMPLATE=""         # approved template name
# WHATSAPP_TEMPLATE_LANG="en"
