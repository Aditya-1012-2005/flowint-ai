# --- Database (Neon Postgres) ---
# Pooled connection (host contains "-pooler") — used at runtime by the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct connection (no "-pooler") — used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""
# AUTH_URL is optional (trustHost is enabled, so the host is inferred from the
# request). Set it only to force a canonical URL, e.g. in some proxy setups.
# AUTH_URL="https://your-domain.com"

# --- Seed (used only by `npm run prisma:seed` to create the first admin) ---
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""
